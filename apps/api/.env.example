# Postgres connection as the `migrator` role (table owner, used for migrations only)
DATABASE_URL=postgres://migrator:changeme@localhost:5432/reconciliation

# Postgres connection as the `app_user` role (used by the running API for all business queries)
APP_DATABASE_URL=postgres://app_user:changeme@localhost:5432/reconciliation

# Password migrate.ts uses when creating the app_user role for the first time
APP_DB_PASSWORD=changeme

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated list of origins allowed to call this API with credentials
TRUSTED_ORIGINS=http://localhost:3000

PORT=3001

# LLM (OpenAI-compatible). Defaults target Groq; point base_url/model at any
# other OpenAI-compatible provider (OpenRouter, Ollama Cloud, etc.) to swap.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-a-real-key
LLM_MODEL=llama-3.3-70b-versatile
